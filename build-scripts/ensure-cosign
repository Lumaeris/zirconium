#!/usr/bin/env bash

set -xeuo pipefail

mkdir -p "${SRCDIR}/cache"

if [ ! -e "${SRCDIR}/cache/cosign" ] ; then
	COSIGN_BIN_URL="$("${SRCDIR}/build-scripts/ghcurl" https://api.github.com/repos/sigstore/cosign/releases/latest | jq -rc --arg arch "$(arch | sed "s/aarch/arm/;s/x86_/amd/")" '.assets[] | select(.name=="cosign-linux-" + $arch) | .browser_download_url')"
	COSIGN_SUM_URL="$("${SRCDIR}/build-scripts/ghcurl" https://api.github.com/repos/sigstore/cosign/releases/latest | jq -rc '.assets[] | select(.name=="cosign_checksums.txt") | .browser_download_url')"

	"${SRCDIR}/build-scripts/ghcurl" "${COSIGN_BIN_URL}" -Lo "${SRCDIR}/cache/cosign-linux-$(arch | sed "s/aarch/arm/;s/x86_/amd/")"
	"${SRCDIR}/build-scripts/ghcurl" "${COSIGN_SUM_URL}" -Lo "${SRCDIR}/cache/cosign.sums"

	pushd "${SRCDIR}/cache"
		sha256sum -c "cosign.sums" --ignore-missing --strict
		rm "cosign.sums"
		mv cosign* "cosign"
	popd

	chmod +x "${SRCDIR}/cache/cosign"
fi
